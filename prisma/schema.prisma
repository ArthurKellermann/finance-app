generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id            String                   @id @default(uuid())
  name          String
  type          TransactionType
  categoryId    String
  subCategoryId String?
  amount        Decimal                  @db.Decimal(10, 2)
  paymentMethod TransactionPaymentMethod
  creditCardId  String?
  date          DateTime
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  userId        String

  category               Category              @relation(fields: [categoryId], references: [id])
  subCategory            SubCategory?          @relation(fields: [subCategoryId], references: [id])
  creditCard             CreditCard?           @relation(fields: [creditCardId], references: [id])
  scheduledTransactionId String?
  scheduledTransaction   ScheduledTransaction? @relation("ScheduledTransactionToTransaction", fields: [scheduledTransactionId], references: [id])

  @@map("transactions")
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  INVESTMENT
}

model Category {
  id        String          @id @default(uuid())
  name      String          @unique
  isDefault Boolean         @default(false)
  userId    String?
  icon      String
  color     String
  type      TransactionType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  subCategories         SubCategory[]
  transactions          Transaction[]
  scheduledTransactions ScheduledTransaction[]

  @@map("categories")
}

model SubCategory {
  id         String   @id @default(uuid())
  name       String
  categoryId String
  userId     String
  createdAt  DateTime @default(now())
  updatedAi  DateTime @updatedAt

  category             Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  ScheduledTransaction ScheduledTransaction[]

  @@map("sub_category")
}

enum TransactionPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CASH
  PIX
  OTHER
}

model CreditCard {
  id                String           @id @default(uuid())
  description       String
  status            CreditCardStatus
  limit             Float
  spent             Float
  imagePath         String
  type              CreditCardType
  bank              Banks
  statementCloseDay Int
  dueDay            Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  userId            String

  transactions          Transaction[]
  scheduledTransactions ScheduledTransaction[]

  @@map("credit_cards")
}

enum CreditCardType {
  VISA
  MASTERCARD
  ELO
  AMERICAN_EXPRESS
  HIPERCARD
  OTHER
}

enum CreditCardStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  EXPIRED
  CANCELLED
}

enum Banks {
  BRADESCO
  ITAU
  CAIXA_ECONOMICA
  SANTANDER
  BANCO_DO_BRASIL
  NUBANK
  HSBC
  BANRISUL
  BNB
  BTG_PACTUAL
  ORIGINAL
  INTER
  PAN
  OTHER
}

model Goal {
  id            String     @id @default(uuid())
  name          String
  description   String
  status        GoalStatus
  targetDate    DateTime
  goalAmount    Float
  currentAmount Float
  color         String
  icon          String
  userId        String
  createdAt     DateTime   @default(now())
  updatedAi     DateTime   @updatedAt

  goalDeposits GoalDeposit[]

  @@map("goals")
}

model GoalDeposit {
  id        String   @id @default(uuid())
  goalId    String
  amount    Float
  date      DateTime
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id])

  @@map("goal_deposit")
}

enum GoalStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

model CalendarEvent {
  id          String   @id @default(uuid())
  userId      String
  title       String
  date        String
  endDate     String?
  time        String
  endTime     String?
  category    String
  description String
  isAllDay    Boolean
  reminder    String?
  recurrence  String?
  location    String?
  attendees   String[]
  color       String?

  @@map("calendar_events")
}

enum RecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ScheduledTransactionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model ScheduledTransaction {
  id                 String                     @id @default(uuid())
  userId             String
  name               String
  amount             Float
  type               TransactionType
  categoryId         String
  subCategoryId      String?
  paymentMethod      TransactionPaymentMethod
  startDate          DateTime
  endDate            DateTime?
  isRecurring        Boolean                    @default(false)
  recurrenceType     RecurrenceType?
  recurrenceInterval Int?
  creditCardId       String?
  description        String?
  status             ScheduledTransactionStatus @default(ACTIVE)
  lastExecutionDate  DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  category     Category      @relation(fields: [categoryId], references: [id])
  subCategory  SubCategory?  @relation(fields: [subCategoryId], references: [id])
  creditCard   CreditCard?   @relation(fields: [creditCardId], references: [id])
  transactions Transaction[] @relation("ScheduledTransactionToTransaction")

  @@index([userId])
  @@index([categoryId])
  @@index([startDate])
  @@index([status])
}
