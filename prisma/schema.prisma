generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id            String                   @id @default(uuid())
  name          String
  type          TransactionType
  categoryId    String
  amount        Decimal                  @db.Decimal(10, 2)
  paymentMethod TransactionPaymentMethod
  creditCardId  String?
  date          DateTime
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  userId        String

  category   Category    @relation(fields: [categoryId], references: [id])
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id])

  @@map("transactions")
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  INVESTMENT
}

model Category {
  id          String        @id @default(uuid())
  name        String        @unique
  isDefault   Boolean       @default(false)
  userId      String?
  icon        String
  color       String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Transaction Transaction[]

  @@map("categories")
}

enum TransactionPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CASH
  PIX
  OTHER
}

model CreditCard {
  id                String           @id @default(uuid())
  description       String
  status            CreditCardStatus
  limit             Float
  spent             Float
  imagePath         String
  type              CreditCardType
  bank              Banks
  statementCloseDay Int
  dueDay            Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  userId            String
  Transaction       Transaction[]

  @@map("credit_cards")
}

enum CreditCardType {
  VISA
  MASTERCARD
  ELO
  AMERICAN_EXPRESS
  HIPERCARD
  OTHER
}

enum CreditCardStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  EXPIRED
  CANCELLED
}

enum Banks {
  BRADESCO
  ITAU
  CAIXA_ECONOMICA
  SANTANDER
  BANCO_DO_BRASIL
  NUBANK
  HSBC
  BANRISUL
  BNB
  BTG_PACTUAL
  ORIGINAL
  INTER
  PAN
  OTHER
}

model Goal {
  id            String     @id @default(uuid())
  name          String
  description   String
  status        GoalStatus
  targetDate    DateTime
  goalAmount    Float
  currentAmount Float
  color         String
  icon          String
  userId        String
  createdAt     DateTime   @default(now())
  updatedAi     DateTime   @updatedAt

  @@map("goals")
}

enum GoalStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}
